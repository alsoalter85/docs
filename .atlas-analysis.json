  "keyFeatures": [
    "Composable workflow pipelines with AI modules",
    "Dataset management with deduplication and filtering",
    "Agent templates for common enrichment tasks",
    "Automated scheduling of workflow runs",
    "OAuth integrations with third-party services",
    "Databricks import/export support",
    "Real-time WebSocket updates for workflow status",
    "Credit-based usage metering",
    "Draft and versioning system for workflows",
    "CSV import/export for datasets and workflow data"
  ],
  "publicApiSurface": [
    "POST /workflows — Create workflow",
    "GET /workflows — List workflows",
    "PUT /workflows/{workflow_id} — Save workflow",
    "POST /workflows/{workflow_id}/execute — Execute workflow",
    "GET /workflows/{workflow_id}/status — Get workflow status",
    "GET /workflows/{workflow_id}/data — Get workflow data",
    "POST /workflows/{workflow_id}/data/search — Search workflow data",
    "POST /workflows/{workflow_id}/import-data/ — Trigger API import",
    "GET /workflows/{workflow_id}/import-status/ — Get import status",
    "POST /workflows/{workflow_id}/schedules — Create schedule",
    "GET /workflows/{workflow_id}/schedules — List schedules",
    "POST /workflows/execute/live/ — Execute live",
    "GET /datasets/organizations/{org_id}/ — List datasets",
    "POST /datasets/organizations/{org_id}/ — Create dataset",
    "GET /datasets/organizations/{org_id}/{id}/data/ — Get dataset data",
    "POST /datasets/organizations/{org_id}/{id}/deduplicate/ — Deduplicate dataset",
    "GET /datasets/public/{id}/ — Get public dataset info",
    "POST /agents/templates/{agent_id}/copy — Copy agent template",
    "GET /workflows/modules — Get available modules",
    "GET /workflows/modules/{module_id}/schema — Get module schema",
    "GET /oauth/providers — List OAuth providers",
    "POST /oauth/callback — OAuth callback",
    "GET /oauth/connections — List connections",
    "GET /databricks/tables — Get Databricks tables",
    "POST /databricks/import — Trigger Databricks import",
    "POST /databricks/export — Trigger Databricks export",
    "POST /usage/query — Query usage metrics",
    "GET /users/ — Get current user",
    "PATCH /users/ — Update user profile",
    "GET /websocket-info/ — Get WebSocket endpoints info"
  ]
